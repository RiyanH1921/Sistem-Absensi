# Sistem Presensi Environment Variables
SECRET_KEY=cloud-presensi-secret-key-super-secure-2026
JWT_SECRET_KEY=cloud-presensi-jwt-key-2026
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration (SQLite default for zero-setup local dev, MySQL 8 ready)
DATABASE_URL=sqlite:///presensi.db
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/presensi_db

# Attendance & QR Dynamic Settings
QR_ROTATION_SECONDS=30
DEFAULT_MAX_RADIUS_METERS=100
DEFAULT_LATITUDE=-7.156556
DEFAULT_LONGITUDE=112.655523
DEFAULT_LATE_TOLERANCE_MINUTES=15
